  "audit": {
    "liveWriteExempt": [
      {
        "table": "search_entry",
        "reason": "Search's own copy, written by app/changed and each message's write: the write it follows has already been announced."
      },
      {
        "table": "change_log",
        "reason": "The change path itself: app/changed and inbox frames write here, so it can't call app/changed about its own writes."
      },
      {
        "table": "change_channel",
        "reason": "The change path itself: app/changed and inbox frames write here, so it can't call app/changed about its own writes."
      },
      {
        "table": "message",
        "reason": "Too busy for app/changed and its activity row: a send takes its place, then publishes an ids-only hint through changes/record (messages/hint)."
      },
      {
        "table": "conversation_read",
        "reason": "A person's own read position, which nobody else needs to hear about: their other tabs get an ids-only hint through changes/record."
      },
      {
        "table": "conversation_member",
        "reason": "Who's in a DM is private, and app/changed would announce it on the shared app channel: its members hear through changes/record on their own channels (messages/hint)."
      },
      {
        "table": "task_view",
        "reason": "A person's own saved filter, which nobody else needs to hear about: their other tabs get an ids-only hint through changes/record."
      },
      {
        "table": "agent_run",
        "reason": "A run's own state, written many times a minute: agents/changed publishes an ids-only frame on its space or to the DM's members, through changes/record, after each change."
      },
      {
        "table": "doc_state",
        "reason": "A doc's working notes, written on a keystroke and on every save, and read only by the server: nobody's screen shows them."
      },
      {
        "table": "doc",
        "reason": "An autosave must not wake every tab in a space: docs/changed tells the doc's own tabs each save and the space only when it matters. Saving a named version changes only its history note, which no other screen shows."
      },
      {
        "table": "doc_version",
        "reason": "A doc's history, which only the open history sheet reads: it asks when it opens."
      }
    ]
  },
  "qa": {
    "maxLinks": 100,
    "workspace": {
      "checks": [
        {
          "gate": "concurrent senders",
          "run": [
            "frontend/scripts/chat-check.mjs",
            "--backend",
            "{backend}",
            "--frontend",
            "{frontend}",
            "--out",
            "{out}",
            "--concurrent-only"
          ]
        },
        {
          "gate": "concurrent writers",
          "run": [
            "frontend/scripts/change-path-check.mjs",
            "{backend}"
          ]
        },
        {
          "gate": "agent state",
          "run": [
            "frontend/scripts/speed-check.mjs",
            "--backend",
            "{backend}",
            "--frontend",
            "{frontend}",
            "--out",
            "{out}",
            "--only",
            "agent-state"
          ]
        },
        {
          "gate": "keyboard",
          "run": [
            "frontend/scripts/keyboard-check.mjs",
            "--backend",
            "{backend}",
            "--frontend",
            "{frontend}",
            "--out",
            "{out}"
          ]
        },
        {
          "gate": "leaks",
          "run": [
            "frontend/scripts/access-check.mjs",
            "--backend",
            "{backend}",
            "--frontend",
            "{frontend}",
            "--out",
            "{out}",
            "--only",
            "leaks"
          ]
        },
        {
          "gate": "guest walk",
          "run": [
            "frontend/scripts/access-check.mjs",
            "--backend",
            "{backend}",
            "--frontend",
            "{frontend}",
            "--out",
            "{out}",
            "--only",
            "guest"
          ]
        },
        {
          "gate": "removal",
          "run": [
            "frontend/scripts/access-check.mjs",
            "--backend",
            "{backend}",
            "--frontend",
            "{frontend}",
            "--out",
            "{out}",
            "--only",
            "removal"
          ]
        },
        {
          "gate": "emptied workspace and demo doors",
          "run": [
            "frontend/scripts/real-use-check.mjs",
            "--backend",
            "{backend}",
            "--frontend",
            "{frontend}",
            "--out",
            "{out}"
          ]
        },
        {
          "gate": "run start",
          "target": "keyed",
          "run": [
            "frontend/scripts/speed-check.mjs",
            "--backend",
            "{backend}",
            "--frontend",
            "{frontend}",
            "--out",
            "{out}",
            "--only",
            "run-start"
          ]
        }
      ]
    }
